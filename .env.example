# Placeholders only. Never commit real values. All variables are server-side.
# See docs/CHAIN_DISCOVERY.md for how each default was verified.

APP_URL=http://localhost:3000
APP_ENV=development

# --- Chain (defaults are verified public values) ---
VIBEVIBE_NETWORK_NAME="Robinhood Chain Testnet"
VIBEVIBE_CHAIN_ID=46630
VIBEVIBE_RPC_HTTP_URL=https://rpc.testnet.chain.robinhood.com
# Optional. No public WS is documented. Alchemy: wss://robinhood-testnet.g.alchemy.com/v2/<YOUR_API_KEY>
VIBEVIBE_RPC_WS_URL=
VIBEVIBE_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# Observed (undocumented) limit of the public RPC. Lower it if your provider is stricter.
GETLOGS_MAX_BLOCK_RANGE=30000
# Observed: address-filtered getLogs accepted spans of 20M+ blocks. The indexer splits on rejection.
GETLOGS_ADDRESS_MAX_BLOCK_RANGE=2000000
# Optional and UNVERIFIED: no official VibeVibe factory address exists. Not used for discovery yet.
VIBEVIBE_FACTORY_ADDRESS=
VIBEVIBE_FACTORY_START_BLOCK=

# --- Database (PostgreSQL, e.g. Neon) ---
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Indexer / scanner ---
# Blocks behind head that scans treat as final (reorg margin).
INDEXER_CONFIRMATIONS=2
# Max wall-clock time one scan spends indexing transfers before reporting a partial result.
INDEXER_SCAN_BUDGET_MS=90000
# Wall-clock budget for explorer-backed creator and coordination lookups in one scan. Lookups not finished by then are reported as unresolved.
ANALYSIS_BUDGET_MS=45000
# Worker queue poll interval.
INDEXER_POLL_INTERVAL_MS=3000
# Optional lower bound for indexing when a token's creation block cannot be found.
INDEXER_START_BLOCK=

# --- API ---
# Secret used to hash client IPs for rate limiting. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=change-me
